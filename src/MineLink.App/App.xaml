<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MineLink_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MineLink_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- docs/04_GUI画面設計.md 2.テーマ: エメラルドグリーン基調のアクセント -->
            <Color x:Key="SystemAccentColor">#2EA043</Color>
            <Color x:Key="SystemAccentColorLight1">#4CC162</Color>
            <Color x:Key="SystemAccentColorLight2">#6FD684</Color>
            <Color x:Key="SystemAccentColorLight3">#97E6A6</Color>
            <Color x:Key="SystemAccentColorDark1">#23803A</Color>
            <Color x:Key="SystemAccentColorDark2">#1A602C</Color>
            <Color x:Key="SystemAccentColorDark3">#124420</Color>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#F2B705" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#E5484D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
