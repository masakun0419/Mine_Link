<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MineLink_App.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MineLink - 初回セットアップ"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Padding="40" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="MineLinkへようこそ" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="はじめに、表示名とMinecraftのエディションを設定してください。" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="表示名" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="DisplayNameBox" PlaceholderText="1〜16文字" MaxLength="16" Text="Player" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="エディション" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="EditionCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Java Edition" />
                <ComboBoxItem Content="統合版（Bedrock）※初版未対応" IsEnabled="False" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="既定のサーバーポート" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <NumberBox x:Name="PortBox" Value="25565" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="スキップ" Click="Skip_Click" />
            <Button Content="開始する" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
