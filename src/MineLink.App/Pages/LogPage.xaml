<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MineLink_App.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MineLink_App.Pages"
    xmlns:models="using:MineLink_App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ログ" Style="{StaticResource TitleLargeTextBlockStyle}" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind AppState.Logs}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LogEntry">
                    <Grid ColumnSpacing="10" Padding="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="{x:Bind local:LogPage.GlyphFor(Severity)}" Foreground="{x:Bind local:LogPage.BrushFor(Severity)}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Timestamp}" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
