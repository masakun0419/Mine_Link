<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MineLink_App.Pages.RoomHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MineLink_App.Pages"
    xmlns:models="using:MineLink_App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Pivot x:Name="RoomPivot" Margin="24,12,24,12">

        <!-- UI-03 ルーム公開 -->
        <PivotItem Header="公開">
            <ScrollViewer>
                <Grid ColumnSpacing="32" RowSpacing="16" MaxWidth="900" HorizontalAlignment="Left" Padding="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 入力フォーム -->
                    <StackPanel Grid.Column="0" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="エディション" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="Java Edition" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="サーバーアドレス" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="PublishAddressBox" Text="127.0.0.1" PlaceholderText="127.0.0.1" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="サーバーポート" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <NumberBox x:Name="PublishPortBox" Value="25565" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="最大参加人数" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <NumberBox x:Name="MaxPlayersBox" Value="5" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="参加承認" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="ApprovalCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="自動承認" />
                                <ComboBoxItem Content="手動承認" />
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="PublishActionButton" Content="公開する" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="PublishAction_Click" />
                    </StackPanel>

                    <!-- 公開後の表示 -->
                    <StackPanel Grid.Column="1" Spacing="16" x:Name="PublishedPanel" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="参加コード" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <TextBlock x:Name="JoinCodeText" Style="{StaticResource TitleLargeTextBlockStyle}" FontFamily="Consolas" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="コピー" Click="CopyCode_Click" />
                                    <Button Content="有効期限更新" Click="RenewCode_Click" />
                                    <Button Content="公開停止" Click="StopPublish_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource StatusSuccessBrush}" FontSize="14" />
                                    <TextBlock Text="Minecraft Serverへの疎通: 確認済み" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="接続者" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView x:Name="MembersList" ItemsSource="{x:Bind AppState.Members}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoomMember">
                                        <Grid ColumnSpacing="16" Padding="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PingMs}" VerticalAlignment="Center" Opacity="0.7" />
                                            <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0" />
                                            <Button Grid.Column="3" Content="切断" Click="KickMember_Click" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </PivotItem>

        <!-- UI-04 ルーム参加 -->
        <PivotItem Header="参加">
            <ScrollViewer>
                <StackPanel Spacing="14" MaxWidth="420" HorizontalAlignment="Left" Padding="0,16,0,16">

                    <StackPanel Spacing="6">
                        <TextBlock Text="参加コード" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="JoinCodeBox" PlaceholderText="XXXXXX" MaxLength="8" TextChanged="JoinCodeBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="表示名" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="JoinDisplayNameBox" PlaceholderText="1〜16文字" MaxLength="16" Text="Player" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ローカルポート" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="LocalPortModeCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="LocalPortModeCombo_SelectionChanged">
                            <ComboBoxItem Content="自動選択" />
                            <ComboBoxItem Content="手動指定" />
                        </ComboBox>
                        <NumberBox x:Name="LocalPortBox" Value="25565" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" IsEnabled="False" />
                    </StackPanel>

                    <Button x:Name="JoinActionButton" Content="参加する" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="JoinAction_Click" />

                    <Border x:Name="ConnectedPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="接続先" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <TextBlock x:Name="LocalAddressText" Style="{StaticResource TitleLargeTextBlockStyle}" FontFamily="Consolas" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="コピー" Click="CopyLocalAddress_Click" />
                                <Button Content="Minecraftを起動" Style="{StaticResource AccentButtonStyle}" Click="LaunchMinecraft_Click" />
                                <Button Content="切断" Click="Disconnect_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
