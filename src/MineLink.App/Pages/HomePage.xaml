<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MineLink_App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MineLink_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="28" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Minecraftで一緒に遊ぼう" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="ポート開放なしで、離れたフレンドとマルチプレイできます。" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <Button Width="180" Height="96" Click="Publish_Click">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="24" HorizontalAlignment="Center" />
                    <TextBlock Text="公開する" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Button>
            <Button Width="180" Height="96" Style="{StaticResource AccentButtonStyle}" Click="Join_Click">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B5;" FontSize="24" HorizontalAlignment="Center" />
                    <TextBlock Text="参加する" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="最近使用した設定" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12">
                <TextBlock Text="{x:Bind AppState.LastSettingsSummary, Mode=OneWay}" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
