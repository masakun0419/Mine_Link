<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MineLink_App.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MineLink_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="通信状況" Style="{StaticResource TitleLargeTextBlockStyle}" />

        <TextBlock Grid.Row="1" x:Name="NotConnectedText" Text="現在、公開中または接続中のルームはありません。" Opacity="0.7" Visibility="Visible" />

        <StackPanel Grid.Row="2" x:Name="StatsPanel" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Width="180">
                <StackPanel Spacing="4">
                    <TextBlock Text="Ping" Opacity="0.7" />
                    <TextBlock x:Name="PingText" Text="-- ms" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Width="180">
                <StackPanel Spacing="4">
                    <TextBlock Text="送受信量" Opacity="0.7" />
                    <TextBlock x:Name="BandwidthText" Text="-- KB/s" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Width="180">
                <StackPanel Spacing="4">
                    <TextBlock Text="セッション時間" Opacity="0.7" />
                    <TextBlock x:Name="SessionText" Text="00:00:00" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
